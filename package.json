{
  "name": "yuchai-learning-h5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:voice": "esbuild node_modules/ogg-opus-decoder/index.js --bundle --minify --format=esm --platform=browser --target=es2020 --outfile=public/assets/opus-decoder.js",
    "start": "node server.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check public/voice.js && node --check public/curriculum.js",
