# Supply these through the host environment, or copy this template to .env.local.
# Local startup reads .env.local; credentials are never exposed to the browser.
SPARRING_OPENAPI_ACCESS_KEY=
SPARRING_OPENAPI_SECRET_KEY=
# Optional local port. The server binds to 127.0.0.1.
PORT=5317
# Exact public origin accepted behind the loopback Nginx reverse proxy.
# Example: https://training.example.com (without a path).
PUBLIC_ORIGIN=
